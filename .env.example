VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy Supabase anon keys are accepted when a project has not switched to publishable keys.
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Never prefix these values with VITE_ or expose them to the browser.
RESEND_API_KEY=your-resend-sending-key
RESEND_FROM_EMAIL=Wildcrown Games <contact@mail.wildcrown.games>
